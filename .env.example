# Copy this file to .env before running docker compose. All values below are safe, local-only
# development placeholders — never used outside your own machine.

POSTGRES_USER=nexusai
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=nexusai
POSTGRES_PORT=5432

# Optional Phase 4 semantic-search tuning. Defaults are sized for a 16 GB Apple Silicon Mac.
NEXUSAI_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
NEXUSAI_SEMANTIC_MIN_SCORE=0.55

# Local Phase 6 speech-to-text model. `base` is multilingual and practical on 16 GB RAM.
NEXUSAI_WHISPER_MODEL=base
# Local grounded answers
NEXUSAI_OLLAMA_URL=http://127.0.0.1:11434
NEXUSAI_ANSWER_MODEL=qwen3:1.7b
