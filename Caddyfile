{$NEXUSAI_DOMAIN} {
    encode zstd gzip

    handle /api/* {
        reverse_proxy api:8000
    }
    handle /health* {
        reverse_proxy api:8000
    }
    handle /metrics {
        reverse_proxy api:8000
    }
    handle {
        reverse_proxy frontend:80
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
        -Server
    }
}
